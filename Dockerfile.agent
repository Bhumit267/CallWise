# ==============================================================================
# Callwise Voice Pipeline Agent Dockerfile
# Pre-downloads Silero VAD, LiveKit models, and sentence-transformers at build time
# ==============================================================================

FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /bin/uv

# Increase timeout so large Linux wheels do not time out
ENV UV_HTTP_TIMEOUT=180

# Copy lockfile, project metadata, and source
COPY pyproject.toml uv.lock README.md ./
COPY src/ ./src/

# Install from lockfile into isolated virtual environment
RUN uv venv /opt/venv && \
    uv pip install --no-cache --python /opt/venv/bin/python .

# ==============================================================================
# Final Runtime Stage
# ==============================================================================
FROM python:3.12-slim AS runner

WORKDIR /app

# Install minimal runtime dependencies (curl for healthchecks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy virtualenv and code from builder
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app /app

# Create unprivileged callwise user with home directory for caches
RUN groupadd -g 1001 callwise && \
    useradd -u 1001 -g callwise -m callwise && \
    chown -R callwise:callwise /app

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME="/home/callwise/.cache/huggingface"

# Switch to non-root user
USER callwise

# Pre-download LiveKit plugin models and embedding model at build time
# Confirmed cache paths:
#   - LiveKit plugins / Silero: /home/callwise/.cache/livekit
#   - HuggingFace sentence-transformers: /home/callwise/.cache/huggingface/hub
RUN python -m livekit.agents download-files && \
    python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

ENTRYPOINT ["python", "-m", "callwise.cli", "run-agent"]
CMD ["-b", "11111111-1111-1111-1111-111111111111", "-m", "dev"]

