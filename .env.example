# ==========================================
# Callwise Environment Configuration
# Copy this file to .env and fill in your keys
# ==========================================

# Database
# Async connection for application queries
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/callwise
# Sync connection for Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5433/callwise

# LiveKit (Real-time WebRTC audio pipeline)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# LLM Configuration (Options: "groq", "gemini", "ollama")
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Speech-to-Text (STT)
DEEPGRAM_API_KEY=your-deepgram-api-key

# Text-to-Speech (TTS) (Options: "deepgram", "cartesia")
TTS_PROVIDER=deepgram
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_VOICE=248be419-c632-4f23-adf1-5324ed7dbf1d
DEEPGRAM_VOICE=aura-asteria-en

# Embeddings (Local sentence-transformers model)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
SIMILARITY_THRESHOLD=0.45

# Calendar & Booking (Options: "local", "google")
CALENDAR_PROVIDER=local
MIN_BOOKING_NOTICE_HOURS=2
GOOGLE_CALENDAR_CREDENTIALS_FILE=
